{
  "name": "gladys-moon-phase",
  "version": "1.0.0",
  "private": true,
  "description": "External Gladys Assistant integration adding a moon phase dashboard widget: phase, illumination, moonrise and moonset, upcoming lunar events.",
  "homepage": "https://github.com/William-De71/gladys-moon-phase",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/William-De71/gladys-moon-phase.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changelog": "conventional-changelog -n ./changelog.config.mjs -i CHANGELOG.md -s -r 1",
